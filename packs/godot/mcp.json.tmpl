{
  "mcpServers": {
    "godot-mcp-native": {
      "url": "http://localhost:9080/mcp"
    },
    "godot-mcp-runtime": {
      "command": "godot-mcp-runtime",
      "args": [],
      "env": {
        "GODOT_PATH": "{{GODOT_PATH}}"
      }
    },
    "codebase-memory-mcp": {
      "command": "codebase-memory-mcp",
      "args": [],
      "env": {
        "CBM_CACHE_DIR": ".codebase-memory/cache"
      }
    }
  }
}